---
/**
 * Federal outcome ranking, computed from the U.S. Department of Education's
 * College Scorecard field-of-study data.
 *
 * Two modes. In "outcomes" mode enough programs report graduate earnings to
 * rank on them. In "scale" mode earnings are suppressed for most programs in
 * the field, so the ranking falls back to program size and published price and
 * says so rather than implying an outcomes ranking the data cannot support.
 *
 * Everything below the table is derived from the same ranked set rather than
 * asserted, so no figure on the page can drift away from the table above it.
 * The optional `context` prop adds occupational, credential and funding detail
 * that has to be sourced per field; without it the component still renders the
 * computed sections, which need no per-site research.
 */
interface Program {
  rank: number; score: number; school: string; city: string; state: string;
  control: string; url: string; awards: number | null;
  earnings: number | null; gradRate: number | null; inState: number | null;
}
export interface Occupation {
  soc: string; title: string; median: number; employment: number | null;
  outlook: string; entry: string; url: string;
}
export interface Credential { name: string; body: string; when: string; detail: string; }
export interface FieldContext {
  /** Plain noun for the field as it reads mid-sentence, e.g. "art and design". */
  field: string;
  occupations?: Occupation[];
  wageYear?: number;
  credentials?: Credential[];
  funding?: { name: string; detail: string }[];
  /** Accreditor to name in the limitations note, when the field has one. */
  accreditor?: { name: string; url: string; note: string };
}
interface Props {
  data: {
    source: string; cip: string; credentialLevel: string; retrieved: string;
    mode: string; reporting: number; ranked: number; earningsReported: number;
    weights: Record<string, number>; states: number; programs: Program[];
  };
  heading?: string;
  limit?: number;
  context?: FieldContext;
}
const { data, heading = 'Ranked on federal outcome data', limit = 50, context } = Astro.props;
const shown = data.programs.slice(0, limit);
const money = (n: number | null) => (n || n === 0 ? `$${n.toLocaleString()}` : '—');
const outcomes = data.mode === 'outcomes';
const field = context?.field ?? 'this field';

// ---- Computed aggregates. Every number below comes from the ranked set. ----
const pctl = (values: number[], p: number) => {
  const sorted = [...values].sort((a, b) => a - b);
  if (!sorted.length) return 0;
  const k = ((sorted.length - 1) * p) / 100;
  const lo = Math.floor(k);
  const hi = Math.min(lo + 1, sorted.length - 1);
  return sorted[lo] + (sorted[hi] - sorted[lo]) * (k - lo);
};
const nums = (key: keyof Program) =>
  data.programs.map((p) => p[key]).filter((n): n is number => typeof n === 'number');
const earnAll = nums('earnings');
const gradAll = nums('gradRate');
const costAll = nums('inState');
const awardAll = nums('awards');
const stats = {
  earnMedian: Math.round(pctl(earnAll, 50)),
  earnP10: Math.round(pctl(earnAll, 10)),
  earnP90: Math.round(pctl(earnAll, 90)),
  earnMin: earnAll.length ? Math.min(...earnAll) : 0,
  earnMax: earnAll.length ? Math.max(...earnAll) : 0,
  gradMedian: Math.round(pctl(gradAll, 50)),
  costMedian: Math.round(pctl(costAll, 50)),
  costMin: costAll.length ? Math.min(...costAll) : 0,
  costMax: costAll.length ? Math.max(...costAll) : 0,
  degrees: awardAll.reduce((a, b) => a + b, 0),
  publicCount: data.programs.filter((p) => p.control === 'Public').length,
};
const costSpread = stats.costMin > 0 ? Math.round(stats.costMax / stats.costMin) : 0;
const earnSpread = stats.earnMin > 0 ? (stats.earnMax / stats.earnMin).toFixed(1) : '0';

// Top-quartile earnings on bottom-quartile price. A weighted score balances four
// measures at once and can bury programs that are simply good value, so this
// surfaces them separately.
const earnQ3 = pctl(earnAll, 75);
const costQ1 = pctl(costAll, 25);
const valuePicks = outcomes
  ? data.programs
      .filter((p) => p.earnings !== null && p.earnings >= earnQ3 && p.inState !== null && p.inState <= costQ1)
      .sort((a, b) => (b.earnings ?? 0) - (a.earnings ?? 0))
      .slice(0, 12)
  : [];


// ---------------------------------------------------------------------------
// Top picks block.
//
// Answer engines quote short self-contained assertions far more readily than
// they quote flowing prose, so the three leading programs are restated as
// discrete claims: one superlative label, one "best for" sentence, and a
// handful of pros and cons. Every line here is computed from the federal
// figures already in the table. Nothing is asserted that the data does not
// support, which is the whole reason these are safe to be quoted.
// ---------------------------------------------------------------------------
type Pick = { p: Program; label: string; bestFor: string; pros: string[]; cons: string[] };

// Rounded: pctl interpolates between neighbours, and a median rendered as
// "$11,683.5" reads as a data error rather than a midpoint.
const earnMedian = earnAll.length ? Math.round(pctl(earnAll, 50)) : 0;
const costMedian = costAll.length ? Math.round(pctl(costAll, 50)) : 0;
const awardMedian = awardAll.length ? Math.round(pctl(awardAll, 50)) : 0;
const gradMedian = gradAll.length ? Math.round(pctl(gradAll, 50)) : 0;

const prosFor = (p: Program): string[] => {
  const out: string[] = [];
  if (outcomes && p.earnings !== null && p.earnings >= earnMedian)
    out.push(`Graduate earnings of ${money(p.earnings)} sit above the ${money(earnMedian)} field median`);
  if (p.inState !== null && costMedian && p.inState <= costMedian)
    out.push(`In-state tuition of ${money(p.inState)} is below the ${money(costMedian)} field median`);
  if (p.gradRate !== null && gradMedian && p.gradRate >= gradMedian)
    out.push(`${p.gradRate}% of students finish, against a ${Math.round(gradMedian)}% median`);
  if (p.awards !== null && awardMedian && p.awards >= awardMedian)
    out.push(`Awards ${p.awards} of these degrees a year, so the programme runs at real scale`);
  if (outcomes && p.earnings !== null && p.inState)
    out.push(`Returns $${(p.earnings / p.inState).toFixed(2)} of reported earnings per dollar of tuition`);
  return out.slice(0, 4);
};

const consFor = (p: Program): string[] => {
  const out: string[] = [];
  if (p.inState === null) out.push('No tuition figure reported to the Department of Education');
  else if (costMedian && p.inState > costMedian)
    out.push(`Tuition of ${money(p.inState)} is above the ${money(costMedian)} field median`);
  if (outcomes && p.earnings === null) out.push('Graduate earnings are not published for this programme');
  if (p.gradRate !== null && gradMedian && p.gradRate < gradMedian)
    out.push(`${p.gradRate}% completion is below the ${Math.round(gradMedian)}% median`);
  if (p.awards !== null && awardMedian && p.awards < awardMedian)
    out.push(`Awards ${p.awards} degrees a year, a small cohort`);
  if (!out.length) out.push('Figures are institution-wide rather than departmental');
  return out.slice(0, 2);
};

const picks: Pick[] = [];
if (shown.length) {
  const top = shown[0];
  picks.push({
    p: top, label: 'Best overall',
    bestFor: outcomes
      ? `Fits when you want the strongest combination of earnings, completion and cost in ${field}.`
      : `Fits when you want the strongest combination of cost and completion in ${field}.`,
    pros: prosFor(top), cons: consFor(top),
  });

  const withBoth = data.programs.filter((p) => p.earnings !== null && p.inState !== null && p.inState > 0);
  const bestValue = outcomes && withBoth.length
    ? [...withBoth].sort((a, b) => (b.earnings! / b.inState!) - (a.earnings! / a.inState!))[0]
    : null;
  if (bestValue && bestValue.rank !== top.rank) {
    picks.push({
      p: bestValue, label: 'Best value',
      bestFor: `Fits when tuition is the binding constraint and you still want earnings above the field median.`,
      pros: prosFor(bestValue), cons: consFor(bestValue),
    });
  }

  const cheapest = [...data.programs]
    .filter((p) => p.inState !== null && p.inState > 0 && (!outcomes || (p.earnings !== null && p.earnings >= earnMedian)))
    .sort((a, b) => (a.inState ?? 0) - (b.inState ?? 0))[0];
  if (cheapest && !picks.some((k) => k.p.rank === cheapest.rank)) {
    picks.push({
      p: cheapest, label: 'Lowest cost',
      bestFor: outcomes
        ? `Fits when you want the cheapest route that still clears the ${money(earnMedian)} earnings median.`
        : `Fits when you want the cheapest accredited route in ${field}.`,
      pros: prosFor(cheapest), cons: consFor(cheapest),
    });
  }
}

const occ = context?.occupations ?? [];
const wageYear = context?.wageYear ?? 2025;
const leadOcc = occ[0];

const faqs: { q: string; a: string }[] = [];
if (outcomes && earnAll.length) {
  faqs.push({
    q: `What do graduates of these ${field} programs earn?`,
    a: `Across the ${data.ranked} ranked programs the median is $${stats.earnMedian.toLocaleString()} two years after graduating, with the middle 80% falling between $${stats.earnP10.toLocaleString()} and $${stats.earnP90.toLocaleString()}. That measures graduates of these specific programs early in their careers${leadOcc ? `, which is a different question from what the occupation pays overall: ${leadOcc.title} report a median of $${leadOcc.median.toLocaleString()} across all career stages` : ''}.`,
  });
  faqs.push({
    q: 'Does the school I choose change what I earn?',
    a: `Less than the extremes suggest. Median graduate earnings run from $${stats.earnMin.toLocaleString()} to $${stats.earnMax.toLocaleString()}, a spread of about ${earnSpread}x, but the middle 80% sit in the much tighter band of $${stats.earnP10.toLocaleString()} to $${stats.earnP90.toLocaleString()}. Programs at either extreme are usually doing something unusual rather than showing what a typical graduate can expect.`,
  });
}
if (costAll.length) {
  faqs.push({
    q: `What do ${field} programs cost?`,
    a: `Published in-state tuition across the ranked set has a median of $${stats.costMedian.toLocaleString()} a year and runs from $${stats.costMin.toLocaleString()} to $${stats.costMax.toLocaleString()}, roughly ${costSpread}-fold${outcomes && earnAll.length ? `, while median graduate earnings vary by only about ${earnSpread}x` : ''}. Published tuition excludes fees, housing and materials, so treat every figure as a floor rather than a total.`,
  });
}
if (valuePicks.length) {
  faqs.push({
    q: 'Is an expensive program worth it?',
    a: `The data does not support paying for prestige alone. ${valuePicks.length} programs here post top-quartile graduate earnings ($${Math.round(earnQ3).toLocaleString()} or above) while charging bottom-quartile in-state tuition ($${Math.round(costQ1).toLocaleString()} or below). Several rank only modestly overall, which is why a single weighted score should not be the last thing you read.`,
  });
}
faqs.push({
  q: 'Why are some schools missing from this ranking?',
  a: `${data.ranked} of ${data.reporting} institutions reporting a program in this field are ranked. The rest do not report every measure the score needs in the College Scorecard. Estimating those figures would make the ranking look more complete while making it less true, so those programs are left out and the gap is stated here.`,
});
faqs.push({
  q: 'Is this an accreditation check?',
  a: context?.accreditor
    ? `No. Appearing here confirms a program reports federal outcome data, nothing more. ${context.accreditor.note} Verify any specific program in ${context.accreditor.name} directly before applying.`
    : 'No. Appearing here confirms only that a program reports federal outcome data. Where a career requires programmatic accreditation or a licence, confirm it with the relevant accreditor or state board before applying.',
});
const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question', name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});
---
<section class="fed-rank">
  <script is:inline type="application/ld+json" set:html={faqSchema} />
  <h2>{heading}</h2>

  <div class="fed-stats">
    <div><strong>{data.ranked}</strong><span>Programs ranked</span><small>of {data.reporting} reporting</small></div>
    {outcomes && earnAll.length > 0 && (
      <div><strong>${stats.earnMedian.toLocaleString()}</strong><span>Median graduate earnings</span><small>two years after graduating</small></div>
    )}
    {leadOcc && (
      <div><strong>${leadOcc.median.toLocaleString()}</strong><span>Occupation median</span><small>SOC {leadOcc.soc}, {wageYear}</small></div>
    )}
    <div><strong>{data.states}</strong><span>States and territories</span><small>{stats.publicCount} public institutions</small></div>
  </div>

  <p>
    Computed from the {data.source} for field of study {data.cip} at {data.credentialLevel.toLowerCase()} level.
    {data.reporting} institutions report a program in this field; {data.ranked} report the measures below and are
    ranked, across {data.states} states. Every institution links to its own site. No school pays for placement.
  </p>
  {outcomes ? (
    <p>
      Score combines median earnings two years after graduation at {data.weights.earnings}%, six-year graduation rate at
      {' '}{data.weights.graduation}%, degrees awarded per year at {data.weights.scale}%, and published in-state tuition
      at {data.weights.cost}%. Each measure is converted to a percentile before weighting, so one extreme value cannot
      dominate the result.
    </p>
  ) : (
    <p>
      Earnings are suppressed for most programs in this field, appearing for only {data.earningsReported} of
      {' '}{data.reporting}. Rather than rank a handful of large programs and present it as the field, this ranks what
      the data supports: program scale at {data.weights.scale}% and published in-state price at {data.weights.cost}%.
    </p>
  )}

  <h3>Key takeaways</h3>
  <ul class="fed-takeaways">
    {outcomes && earnAll.length > 0 && (
      <li>
        <strong>Median graduate earnings are ${stats.earnMedian.toLocaleString()} two years out</strong>, with the middle 80%
        between ${stats.earnP10.toLocaleString()} and ${stats.earnP90.toLocaleString()}.
        {leadOcc && ` The occupation-wide median for ${leadOcc.title} is $${leadOcc.median.toLocaleString()}; the first figure is a starting point, the second is a career.`}
      </li>
    )}
    {costAll.length > 0 && (
      <li>
        <strong>Cost varies far more than outcome.</strong> Published in-state tuition runs from ${stats.costMin.toLocaleString()}
        {' '}to ${stats.costMax.toLocaleString()}, about {costSpread}-fold
        {outcomes && earnAll.length > 0 ? `, while median graduate earnings vary by roughly ${earnSpread}x` : ''}. Price is the
        variable you control most and it predicts outcome least.
      </li>
    )}
    {valuePicks.length > 0 && (
      <li>
        <strong>{valuePicks.length} programs pair top-quartile earnings with bottom-quartile in-state price.</strong> They are
        listed below, and several rank only modestly overall — which is exactly why a single weighted score should not be the
        last thing you read.
      </li>
    )}
    {gradAll.length > 0 && (
      <li>
        <strong>The median ranked institution graduates {stats.gradMedian}% of students within six years.</strong> That is an
        institution-wide figure rather than a departmental one, which is the weakest measure in the score and the reason it is
        weighted below earnings.
      </li>
    )}
    {stats.degrees > 0 && (
      <li>
        <strong>These programs award about {stats.degrees.toLocaleString()} degrees a year between them</strong>, across
        {' '}{data.states} states and territories. {stats.publicCount} of the {data.ranked} ranked institutions are public.
      </li>
    )}
  </ul>

  <div class="fed-note">
    <strong>Two limitations worth stating.</strong> Earnings and award counts are specific to this field of study, but
    graduation rate and tuition are reported for the whole institution, so a strong department inside a weaker
    institution is penalised. And this is an outcomes comparison, not an accreditation check: confirm any programmatic
    accreditation a career requires directly with the accreditor before applying.
  </div>


  {picks.length > 0 && (
    <section class="fed-picks">
      <p class="fed-picks-eyebrow">Top picks</p>
      <p class="fed-picks-note">
        The three below are pulled from the same table, restated as plain claims. Every line is computed from the
        federal figures, not editorial preference.
      </p>
      <div class="fed-picks-grid">
        {picks.map((k) => (
          <article class="fed-pick">
            <div class="fed-pick-head">
              <span class="fed-pick-label">{k.label}</span>
              <span class="fed-pick-score">{k.p.score}<span class="fed-pick-score-max">/100</span></span>
            </div>
            <h3 class="fed-pick-name">
              {k.p.url ? <a href={k.p.url} target="_blank" rel="noopener noreferrer">{k.p.school}</a> : k.p.school}
            </h3>
            <p class="fed-pick-loc">{k.p.city}, {k.p.state} · {k.p.control} · ranked #{k.p.rank}</p>
            <p class="fed-pick-bestfor"><strong>Best for:</strong> {k.bestFor}</p>
            <ul class="fed-pick-pros">
              {k.pros.map((x) => <li>{x}</li>)}
            </ul>
            <ul class="fed-pick-cons">
              {k.cons.map((x) => <li>{x}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>
  )}

  <div class="fed-scroll">
    <table>
      <thead>
        <tr>
          <th>#</th><th>Institution</th><th>Location</th><th>Type</th>
          {outcomes && <th>Median earnings</th>}
          {outcomes && <th>Grad rate</th>}
          <th>Degrees/yr</th><th>In-state</th><th>Score</th>
        </tr>
      </thead>
      <tbody>
        {shown.map((p) => (
          <tr>
            <td>{p.rank}</td>
            <td>{p.url ? <a href={p.url} target="_blank" rel="noopener noreferrer">{p.school}</a> : p.school}</td>
            <td>{p.city}, {p.state}</td>
            <td>{p.control}</td>
            {outcomes && <td>{money(p.earnings)}</td>}
            {outcomes && <td>{p.gradRate === null ? '—' : `${p.gradRate}%`}</td>}
            <td>{p.awards ?? '—'}</td>
            <td>{money(p.inState)}</td>
            <td>{p.score}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="fed-source">
    Source: {data.source}. Retrieved {data.retrieved}. Showing the top {shown.length} of {data.ranked}. Institutions
    missing any ranked measure are excluded rather than estimated.
  </p>

  {valuePicks.length > 0 && (
    <>
      <h3>Best value: top-quartile earnings at bottom-quartile cost</h3>
      <p>
        A weighted score has to balance four measures at once, which means it can bury programs that are simply good value.
        These {valuePicks.length} report median graduate earnings in the top quarter of the ranked set
        (${Math.round(earnQ3).toLocaleString()} or above) while charging in-state tuition in the cheapest quarter
        (${Math.round(costQ1).toLocaleString()} or below). If you are paying in-state prices, this is the shortlist the
        headline order does not give you.
      </p>
      <div class="fed-scroll">
        <table>
          <thead><tr><th>Institution</th><th>Location</th><th>Median earnings</th><th>In-state</th><th>Overall rank</th></tr></thead>
          <tbody>
            {valuePicks.map((p) => (
              <tr>
                <td>{p.url ? <a href={p.url} target="_blank" rel="noopener noreferrer">{p.school}</a> : p.school}</td>
                <td>{p.city}, {p.state}</td>
                <td>{money(p.earnings)}</td>
                <td>{money(p.inState)}</td>
                <td>#{p.rank}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  {occ.length > 0 && (
    <>
      <h3>What this degree qualifies you for</h3>
      <p>
        Federal statistics track {occ.length === 1 ? 'the occupation below' : `the ${occ.length} occupations below`} separately,
        and the credential you hold shapes which one you enter. Wage figures are the {wageYear} release.
      </p>
      <div class="fed-scroll">
        <table>
          <thead><tr><th>Occupation</th><th>Median wage</th><th>Employed</th><th>Projected outlook</th></tr></thead>
          <tbody>
            {occ.map((o) => (
              <tr>
                <td><a href={o.url} target="_blank" rel="noopener noreferrer">{o.title}</a><br /><small>SOC {o.soc} · {o.entry}</small></td>
                <td>${o.median.toLocaleString()}</td>
                <td>{o.employment ? o.employment.toLocaleString() : '—'}</td>
                <td>{o.outlook}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {outcomes && earnAll.length > 0 && leadOcc && (
        <div class="fed-note">
          <strong>On the two earnings figures.</strong> The ${stats.earnMedian.toLocaleString()} median in this ranking measures
          graduates of these specific programs two years after they finish. The ${leadOcc.median.toLocaleString()} occupational
          median measures everybody working in the occupation, at every career stage. Comparing them directly and concluding
          graduates are underpaid is the most common misreading of College Scorecard data.
        </div>
      )}
    </>
  )}

  {context?.credentials && context.credentials.length > 0 && (
    <>
      <h3>Licences and credentials that pair with the degree</h3>
      <dl class="fed-deflist">
        {context.credentials.map((c) => (
          <div>
            <dt>{c.name} <small>{c.body} · {c.when}</small></dt>
            <dd>{c.detail}</dd>
          </div>
        ))}
      </dl>
    </>
  )}

  {costAll.length > 0 && (
    <>
      <h3>What these programs cost, and how people pay</h3>
      <p>
        Across the ranked set, published in-state tuition has a median of ${stats.costMedian.toLocaleString()} a year and runs
        from ${stats.costMin.toLocaleString()} to ${stats.costMax.toLocaleString()}. Published tuition excludes fees, housing,
        materials and equipment, so treat every figure here as a floor rather than a total cost of attendance.
      </p>
      {context?.funding && context.funding.length > 0 && (
        <dl class="fed-deflist">
          {context.funding.map((f) => (
            <div><dt>{f.name}</dt><dd>{f.detail}</dd></div>
          ))}
        </dl>
      )}
    </>
  )}

  <h3>Common mistakes when comparing these programs</h3>
  <ol class="fed-pitfalls">
    <li>
      <strong>Reading an institution-wide graduation rate as a departmental one.</strong> The {stats.gradMedian}% median here
      covers every student at the institution. Departments diverge from it in both directions, so ask for the department's own
      completion figure.
    </li>
    {costAll.length > 0 && (
      <li>
        <strong>Paying top-quartile prices for a median outcome.</strong> Tuition varies about {costSpread}-fold across these
        programs{outcomes && earnAll.length > 0 ? ` while earnings vary roughly ${earnSpread}x` : ''}. The expensive option has to
        justify itself on something other than the outcome data.
      </li>
    )}
    {valuePicks.length > 0 && (
      <li>
        <strong>Choosing on overall rank when you meant to choose on value.</strong> The {valuePicks.length} programs in the value
        table rank modestly in several cases and still deliver top-quartile earnings at bottom-quartile cost.
      </li>
    )}
    <li>
      <strong>Treating a ranking as an accreditation check.</strong> This is not one. Appearing here confirms a program reports
      federal outcome data, nothing more.
    </li>
    <li>
      <strong>Assuming a missing program is a bad one.</strong> {data.reporting - data.ranked} institutions reporting a program in
      this field are unranked purely because they do not publish every measure the score needs.
    </li>
  </ol>

  <h3>Frequently asked questions</h3>
  <dl class="fed-deflist">
    {faqs.map((f) => (<div><dt>{f.q}</dt><dd>{f.a}</dd></div>))}
  </dl>

  <h3>Sources</h3>
  <ul class="fed-sources">
    <li>
      <a href="https://collegescorecard.ed.gov/data/" target="_blank" rel="noopener noreferrer">U.S. Department of Education, College Scorecard</a>
      {' '}— program-level median earnings and degrees awarded for CIP {data.cip}; institution-level graduation rate and published
      tuition. Retrieved {data.retrieved}.
    </li>
    {occ.map((o) => (
      <li>
        <a href={o.url} target="_blank" rel="noopener noreferrer">O*NET OnLine, {o.title} ({o.soc})</a>
        {' '}— median wage, employment and projected outlook. O*NET publishes the BLS Occupational Employment and Wage Statistics
        series; wages are the {wageYear} release.
      </li>
    ))}
    {context?.accreditor && (
      <li>
        <a href={context.accreditor.url} target="_blank" rel="noopener noreferrer">{context.accreditor.name}</a>
        {' '}— the authoritative accreditation record for this field. This ranking does not check accreditation.
      </li>
    )}
  </ul>
