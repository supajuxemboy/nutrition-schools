---
type Section = {
  heading: string;
  paragraphs: string[];
  bullets?: string[];
  table?: { head: [string, string]; rows: [string, string][] };
};
interface Props { sections: Section[] }
const { sections } = Astro.props;
---
{sections.map(section => (
  <section>
    <h2>{section.heading}</h2>
    {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
    {section.bullets && <ul>{section.bullets.map(bullet => <li>{bullet}</li>)}</ul>}
    {section.table && (
      <div class="table-scroll">
        <table>
          <thead><tr><th>{section.table.head[0]}</th><th>{section.table.head[1]}</th></tr></thead>
          <tbody>{section.table.rows.map(([a, b]) => <tr><td>{a}</td><td>{b}</td></tr>)}</tbody>
        </table>
      </div>
    )}
  </section>
))}
