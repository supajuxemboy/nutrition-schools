---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AiSummary from '../../components/AiSummary.astro';
import Faq from '../../components/Faq.astro';
import Byline from '../../components/Byline.astro';
import { site, team } from '../../data/site';
import { stats } from '../../data/quality-index';
import { outcomesSurvey, qualityStudy } from '../../data/research';

const personSchema = {
  '@context': 'https://schema.org',
  '@graph': team.map(member => ({
    '@type': 'Person',
    '@id': `${site.url}/about/#${member.slug}`,
    name: member.name,
    jobTitle: member.role,
    description: member.bio[0],
    image: new URL(member.photo, site.url).toString(),
    knowsAbout: member.knowsAbout,
    hasCredential: member.certifications.map(credential => ({
      '@type': 'EducationalOccupationalCredential',
      name: credential
    })),
    alumniOf: member.education.map(school => ({ '@type': 'EducationalOrganization', name: school })),
    worksFor: { '@id': `${site.url}/#organization` }
  }))
};

const faq = [
  {
    question: 'Who is behind NutritionSchools.org?',
    answer: `Three co-founders: ${team.map(m => `${m.name}, ${m.role}`).join('; ')}. All three hold the Registered Dietitian Nutritionist credential, and their education and additional certifications are published in full on this page. Every substantial page on the site names the team member who reviewed it.`
  },
  {
    question: 'Do institutions pay to be featured?',
    answer:
      'No. We do not accept payment for inclusion, ranking position, or removal, and we hold no affiliate relationships with any institution we cover. If that ever changes we will disclose it on this page before it appears anywhere else on the site.'
  },
  {
    question: 'Where does your data come from?',
    answer: `Four sources, kept separate and labeled. Institutional publications, meaning what a school says about its own programs, always linked. Accreditation records from ACEND and the Commission on Dietetic Registration. Federal statistics from the Bureau of Labor Statistics, cited by release and date. And our own research, the ${outcomesSurvey.name} and the ${qualityStudy.name}, which are labeled as ours everywhere they appear.`
  },
  {
    question: 'Why does this site have opinions?',
    answer:
      'Because a page that refuses to take a position is useless for a decision. Neutral coverage of nutrition education produces sentences like "consider your goals and budget," which is true and helps nobody. We say which programs and pathways we think are worth the money and we show the data behind it, so you can disagree with the conclusion while keeping the evidence.'
  },
  {
    question: 'How do you handle mistakes?',
    answer:
      'We correct them. If a figure is wrong, a link is dead, or an accreditation status has changed, tell us and we will fix it and note the change. We also flag figures we could not verify to the current release rather than presenting a stale number as current, which is why one occupational wage on this site carries a vintage warning.'
  }
];
---
<BaseLayout
  title="About NutritionSchools.org and Our Team"
  description="Meet the three credentialed co-founders behind NutritionSchools.org, read our mission, editorial policy, and the reasons we built an independent nutrition education research resource."
>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">About</p>
      <h1>Independent nutrition education research, by people who did the pathway</h1>
      <p class="lede">
        Three credentialed practitioners built this site because the advice available to nutrition students was either
        marketing or vague. Our names, qualifications, and standards are all on this page, and every page we publish
        names the person who reviewed it.
      </p>
      <div class="metrics">
        <div><strong>3</strong><span>credentialed co-founders</span></div>
        <div><strong>{stats.programs}</strong><span>programs in our database</span></div>
        <div><strong>{outcomesSurvey.sample.toLocaleString()}</strong><span>graduates in our survey</span></div>
        <div><strong>0</strong><span>paid placements, ever</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <AiSummary>
        NutritionSchools.org is an independent research resource on nutrition, dietetics, and nutritional science
        education in the United States, founded by three credentialed practitioners.
        {team.map(m => ` ${m.name} is ${m.role}, holding ${m.certifications.join(' and ')}, educated at ${m.education.map(e => e.split(', ').slice(-1)[0]).join(', ')}.`)}
        {' '}The site maintains a database of {stats.programs} programs at {stats.schools} institutions across
        {' '}{stats.states} states, publishes {qualityStudy.name} as its ranking methodology, and conducted the
        {' '}{outcomesSurvey.name} covering {outcomesSurvey.sampleLabel}. We accept no payment for inclusion, ranking
        position, or removal, hold no affiliate relationships with institutions we cover, and label the difference between
        institutional claims, accreditation records, federal statistics, and our own editorial opinion on every page. Every
        substantial page names its reviewer. Last reviewed {site.reviewedLabel}.
      </AiSummary>

      <div class="hot-take">
        <strong>Why we started this</strong>
        <p>
          Because the honest information a nutrition student needs is scattered across accreditor databases, federal wage
          tables, and state board statutes, and the sites that promise to assemble it are mostly lead generation with a
          ranking attached. We assembled it, published the method, and took positions we are willing to defend.
        </p>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Meet the team</p>
          <h2>Who reviews what, and why they are qualified to</h2>
        </div>
        <p>All three hold the RDN credential. Each owns a defined area of the site.</p>
      </div>
      <div class="team">
        {team.map(member => (
          <div class="bio" id={member.slug}>
            <img class="bio-photo" src={member.photo} alt={member.name} width="512" height="512" loading="lazy" />
            <div>
              <h3>{member.name}</h3>
              <p class="role">{member.role}</p>
              {member.bio.map(paragraph => <p>{paragraph}</p>)}
              <dl>
                <dt>Education</dt>
                <dd>{member.education.join(' · ')}</dd>
                <dt>Certifications</dt>
                <dd>{member.certifications.join(' · ')}</dd>
                <dt>Areas of expertise</dt>
                <dd>{member.knowsAbout.join(', ')}</dd>
                <dt>Covers on this site</dt>
                <dd>{member.covers}</dd>
              </dl>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <article class="content wrap">
    <Byline author={team[0]} prefix="Edited by" />
    <h2>Our mission</h2>
    <p>
      To make the actual mechanics of a nutrition career legible before someone commits years and money to it. That means
      three specific things: publishing what programs and accreditors actually document rather than what marketing
      departments imply, attaching federal wage and projection data to every career claim, and being explicit about the
      credentialing gates that decide whether a nutrition graduate can practise.
    </p>
    <p>
      It also means taking positions. A nutrition degree is a science degree, supervised practice matters more than
      institutional prestige, and the credential is worth more than the school on your diploma. Those are opinions. We
      label them as opinions and we show the data underneath them, so you can accept the data and reject the conclusion if
      you want to.
    </p>

    <h2>Why we started NutritionSchools.org</h2>
    <p>
      Between us we have spent decades on the other side of this decision: running ACEND accredited programs, directing
      nutrition services in a hospital system, and managing nutrition programs for state health departments. In all three
      settings we met the same person repeatedly. A bright graduate, two or three years and tens of thousands of dollars
      into a nutrition education, who had just discovered that their degree was never on the accredited pathway, or that
      their program did not arrange supervised practice, or that the job they wanted required a credential their program
      could not lead to.
    </p>
    <p>
      None of that information is secret. All of it is published, by ACEND, by the Commission on Dietetic Registration, by
      state boards, and by the institutions themselves. It is simply distributed across a dozen sources in language written
      for administrators rather than for applicants. The sites that promised to assemble it were, with a few exceptions,
      built to generate enrollment leads, and their rankings reflected who paid rather than what was documented.
    </p>
    <p>
      So we built the thing we wanted to hand those graduates three years earlier. A database of real programs with links
      to their own pages. A ranking method published in full, including its blind spots. Career guides with federal wage
      data attached and an honest account of what the work is like. And our own research, because the questions we most
      wanted answered, about where graduates actually end up and what mattered to them, had no good public dataset behind
      them.
    </p>

    <h2>Editorial policy</h2>
    <p>
      We separate four categories of statement and label them wherever they appear.
    </p>
    <ul>
      <li><strong>Institutional claims.</strong> What a school publishes about its own programs: curriculum, tuition, credit load, delivery format. Always linked to the source. We do not verify these independently and we do not present them as verified.</li>
      <li><strong>Accreditation records.</strong> ACEND accreditation status and program type, and Commission on Dietetic Registration credentialing requirements. We name the authority and we tell you to check it, because these change and our snapshot ages.</li>
      <li><strong>Federal statistics.</strong> Bureau of Labor Statistics wage and projection data, cited by release and date. Where we could only verify an older release, we flag it rather than implying it is current. One occupational wage figure on this site carries that flag today.</li>
      <li><strong>Our opinion.</strong> Marked as our take, in a labeled box, and always supported by something above it. If we cannot point at the evidence, we do not publish the opinion.</li>
    </ul>
    <p>
      Additional standards we hold to. No institution pays for inclusion, position, or removal, and we hold no affiliate
      relationships. Every substantial page names the credentialed team member who reviewed it. We publish what our ranking
      method cannot measure alongside what it can. We do not use reputation surveys. We do not use self-reported placement
      rates. And we will not state a state licensure requirement as fact when we cannot verify it continuously, which is
      why every state page tells you to read your own board rules instead.
    </p>

    <h2>Our methodology in brief</h2>
    <p>
      Programs are scored with the {qualityStudy.name}, a seven-factor index distributing 100 points across curriculum
      rigor, supervised practice, faculty credentials, program accreditation, clinical and community partnerships, career
      outcomes, and cost value. Every factor is computed from something an institution or the accreditor publishes, so any
      score can be reconstructed from the record and argued with specifically.
    </p>
    <p>
      The <a class="text-link" href="/methodology/">full methodology</a> covers how each factor is derived and the six
      things the index deliberately does not measure. Our original research, including the survey limitations, is on the
      {' '}<a class="text-link" href="/research/">research page</a> and the
      {' '}<a class="text-link" href="/resources/nutrition-career-outcomes/">Career Outcomes Survey 2026</a>. Rankings
      start at <a class="text-link" href="/rankings/">the rankings index</a>. Career guides start at
      {' '}<a class="text-link" href="/careers/">careers</a>.
    </p>

    <h2>Corrections</h2>
    <p>
      If something on this site is wrong, we want to fix it. Dead program links, changed accreditation status, superseded
      wage figures, and misstated credentialing rules are all worth reporting. We will correct the page and note that we
      did. We would rather be corrected in public than be quietly wrong in a place where somebody is making a decision.
    </p>

    <Faq items={faq} />

    <div class="notice">
      <strong>Independence statement:</strong> NutritionSchools.org accepts no payment from institutions for inclusion,
      ranking position, or removal, and holds no affiliate relationships with any institution covered. Our program records
      link to institutional pages, which are authoritative. Nothing on this site is medical, dietary, or legal advice.
      Last reviewed {site.reviewedLabel}.
    </div>
  </article>
</BaseLayout>
