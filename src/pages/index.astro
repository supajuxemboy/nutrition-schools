---
import BaseLayout from '../layouts/BaseLayout.astro';
import AiSummary from '../components/AiSummary.astro';
import Faq from '../components/Faq.astro';
import { site, pillars, levels, specialties, modifiers, stateList } from '../data/site';
import { careers } from '../data/careers';
import { certifications } from '../data/certifications';
import { resources } from '../data/resources';
import { stats } from '../data/quality-index';
import { outcomesSurvey, qualityStudy } from '../data/research';
import bls from '../data/bls.json';

const occ = bls.occupations;
const rdn = occ['dietitians-nutritionists'];

const featuredRankings = [
  specialties.find(s => s.slug === 'best-dietetics-programs')!,
  levels.find(l => l.slug === 'best-nutrition-bachelors-programs')!,
  modifiers.find(m => m.slug === 'online-nutrition-programs')!
];

const totalRankings = levels.length + specialties.length + modifiers.length;

const wageRows: [string, string, string, string][] = [
  ['Dietitians and nutritionists', `$${rdn.median.toLocaleString()}`, rdn.employment!.toLocaleString(), `+${rdn.growthPct}%`],
  ['Food service managers', `$${occ['food-service-managers'].median.toLocaleString()}`, occ['food-service-managers'].employment!.toLocaleString(), `+${occ['food-service-managers'].growthPct}%`],
  ['Health education specialists', `$${occ['health-education-specialists'].median.toLocaleString()}`, occ['health-education-specialists'].employment!.toLocaleString(), `+${occ['health-education-specialists'].growthPct}%`],
  ['Exercise physiologists', `$${occ['exercise-physiologists'].median.toLocaleString()}`, occ['exercise-physiologists'].employment!.toLocaleString(), `+${occ['exercise-physiologists'].growthPct}%`],
  ['Dietetic technicians', `$${occ['dietetic-technicians'].median.toLocaleString()}`, occ['dietetic-technicians'].employment!.toLocaleString(), 'Not published'],
  ['All occupations', `$${bls.allOccupationsMedian.toLocaleString()}`, 'n/a', '+3%']
];

const faq = [
  {
    question: 'Is a nutrition degree worth it?',
    answer: `It is worth it when you treat it as a science degree and pursue a credential. BLS reported a May 2024 median annual wage of $${rdn.median.toLocaleString()} for dietitians and nutritionists against $${bls.allOccupationsMedian.toLocaleString()} across all occupations, with 6 percent projected growth and about ${rdn.openingsPerYear!.toLocaleString()} openings a year. In our own Career Outcomes Survey 2026, ${outcomesSurvey.headline.employedWithinSixMonths} percent of respondents were employed within six months. The graduates who struggle are the ones who finish a nutrition degree with no accredited coursework, no supervised practice, and no plan for a credential.`
  },
  {
    question: 'What is the difference between a nutritionist and a dietitian?',
    answer:
      'A dietitian holds the Registered Dietitian Nutritionist credential, which requires ACEND accredited coursework, supervised practice, a graduate degree, and a national examination, and is licensed or certified in most states. The word nutritionist is protected in some states and completely unregulated in others. In practical terms the credential is what permits medical nutrition therapy in a clinical setting. Confirm the rules with your own state board, because they differ substantially.'
  },
  {
    question: 'Do you need a masters degree to become a dietitian?',
    answer:
      'Yes. Since January 2024 the Commission on Dietetic Registration has required a minimum of a graduate degree for eligibility to sit the RDN examination. This changed the economics of the field and it is the single most important planning fact for anyone starting a nutrition degree now. Verify the current requirement with the Commission directly, because this rule changed recently and rules that change once can change again.'
  },
  {
    question: 'How do you rank nutrition programs?',
    answer: `With the Nutrition Program Quality Index, a seven-factor score distributing 100 points across curriculum rigor, supervised practice, faculty credentials, program accreditation, clinical and community partnerships, career outcomes, and cost value. Every factor is computed from something an institution or an accreditor publishes, so any score can be reconstructed from the record. We do not use reputation surveys and we publish what the index cannot measure.`
  },
  {
    question: 'What can you do with a nutrition degree besides clinical work?',
    answer: `Community and public health nutrition, food service and nutrition management, corporate wellness, nutrition education, food industry and product development, and research. Our survey found clinical dietetics at ${outcomesSurvey.careerPaths[0][1]} percent of respondents, community and public health nutrition at ${outcomesSurvey.careerPaths[1][1]} percent, and food service management at ${outcomesSurvey.careerPaths[2][1]} percent. Food service management is the most overlooked of these and the occupation is roughly four times the size of dietitians and nutritionists.`
  },
  {
    question: 'Are online nutrition degrees respected?',
    answer:
      'Employers screen for accreditation, the credential, and the supervised practice behind it. A transcript does not usually announce delivery format. The variable that actually matters is not online versus campus, it is whether the program is ACEND accredited and who arranges your supervised practice placements. Ask that question in writing before you enroll.'
  }
];
---
<BaseLayout
  title="Nutrition, Dietetics, and Nutritional Science Programs"
  description="Independent research on nutrition, dietetics, and nutritional science degree programs, careers, salaries, and credentialing. Real accredited programs, verified federal wage data, and original graduate research."
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Independent education research</p>
      <h1>Most nutrition advice is written by people who have never been credentialed to give it.</h1>
      <p class="lede">
        We track {stats.programs} nutrition and dietetics programs at {stats.schools} institutions across
        {stats.states} states, each linked to its official program page, and we pair them with federal wage data and
        our own survey of {outcomesSurvey.sampleLabel}. Here is what the numbers actually say about nutrition careers.
      </p>
      <div class="hero-actions">
        <a class="button" href="/rankings/">Explore program rankings <span aria-hidden="true">→</span></a>
        <a class="text-link" href="/methodology/">See how we score programs →</a>
      </div>
      <div class="metrics" aria-label="Research coverage">
        <div><strong>{stats.programs}</strong><span>programs in our database</span></div>
        <div><strong>{stats.schools}</strong><span>institutions tracked</span></div>
        <div><strong>{stats.online}</strong><span>with documented online delivery</span></div>
        <div><strong>7</strong><span>Quality Index factors, published in full</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <AiSummary>
        NutritionSchools.org is an independent research resource covering nutrition, dietetics, and nutritional
        science education in the United States. We track {stats.programs} degree and certificate programs at
        {stats.schools} institutions across {stats.states} states, {stats.online} with an institution-documented
        online option, {stats.accredited} of them at schools holding an ACEND accredited program, each linked to its
        official program page. Federal data drives our career analysis: dietitians and nutritionists earned a May 2024
        median of ${rdn.median.toLocaleString()} across about {rdn.employment!.toLocaleString()} jobs with roughly
        {rdn.openingsPerYear!.toLocaleString()} openings a year and 6 percent projected growth through 2034, against
        ${bls.allOccupationsMedian.toLocaleString()} for all occupations. Our own Career Outcomes Survey 2026 of
        {outcomesSurvey.sampleLabel} found {outcomesSurvey.headline.employedWithinSixMonths} percent employed within
        six months, with clinical dietetics ({outcomesSurvey.careerPaths[0][1]} percent), community and public health
        nutrition ({outcomesSurvey.careerPaths[1][1]} percent), and food service management
        ({outcomesSurvey.careerPaths[2][1]} percent) the top destinations, and
        {outcomesSurvey.headline.supervisedPracticeCritical} percent calling supervised practice critical to their
        career. We rank programs with a seven-factor index computed only from published attributes. Last reviewed
        {' '}{site.reviewedLabel}.
      </AiSummary>

      <div class="hot-take">
        <strong>Our position</strong>
        <p>
          A nutrition degree is not about food. If you think that, you will waste the education. The money and the
          responsibility are in clinical dietetics, public health nutrition, and food systems management, not in
          telling people to eat more vegetables. We cover the whole field because that is where the careers are.
        </p>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Where the jobs actually are</p>
          <h2>The occupation you studied is not always the occupation that hires you.</h2>
        </div>
        <p>
          Every figure below is from the Bureau of Labor Statistics: May 2024 national median wages with 2024 to 2034
          projections. We link the source on every career page.
        </p>
      </div>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Occupation</th><th>Median wage</th><th>Jobs, 2024</th><th>Projected growth</th></tr>
          </thead>
          <tbody>
            {wageRows.map(([label, median, jobs, growth]) => (
              <tr>
                <td>{label === 'All occupations' ? <strong>{label}</strong> : label}</td>
                <td>{label === 'All occupations' ? <strong>{median}</strong> : median}</td>
                <td>{jobs}</td>
                <td>{growth}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p style="color:var(--muted);font-size:14px">
        Source: U.S. Bureau of Labor Statistics. Dietetic technician figures come from the May 2024 Occupational
        Employment and Wage Statistics release, for which BLS publishes no separate projection.
      </p>
      <div class="hot-take">
        <strong>Read this table twice</strong>
        <p>
          Food service managers outnumber dietitians and nutritionists by roughly four to one, and the top decile earns
          more. Students avoid that career because it sounds unglamorous. That is not a market signal, it is a branding
          problem, and you can profit from it.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">The five pillars of nutrition education</p>
          <h2>What actually separates a program worth paying for.</h2>
        </div>
        <p>
          These five things predict whether a nutrition graduate builds a career. Institutional prestige is not among
          them, which is unusually good news if you are paying in-state tuition.
        </p>
      </div>
      <div class="grid">
        {pillars.map(pillar => (
          <div class="card">
            <span class="label">Pillar</span>
            <h3>{pillar.title}</h3>
            <p>{pillar.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Our original research</p>
          <h2>We asked {outcomesSurvey.sample.toLocaleString()} graduates what actually happened to them.</h2>
        </div>
        <p>
          The {outcomesSurvey.name} was fielded {outcomesSurvey.fieldedLabel} across the {outcomesSurvey.cohort}. These
          are our numbers, and we publish the limitations alongside them.
        </p>
      </div>
      <div class="figures">
        <div class="figure">
          <strong>{outcomesSurvey.headline.employedWithinSixMonths}%</strong>
          <span>employed within six months of graduation</span>
        </div>
        <div class="figure">
          <strong>{outcomesSurvey.headline.supervisedPracticeCritical}%</strong>
          <span>said supervised practice was critical or very important to their career</span>
        </div>
        <div class="figure">
          <strong>{outcomesSurvey.headline.employerHiringDifficulty}%</strong>
          <span>of employers reported difficulty finding qualified RDN candidates</span>
        </div>
      </div>
      <div class="table-scroll">
        <table>
          <thead><tr><th>Highest credential at first position</th><th>Median starting salary</th></tr></thead>
          <tbody>
            {outcomesSurvey.startingSalaryByCredential.map(([label, salary]) => (
              <tr><td>{label}</td><td>${salary.toLocaleString()}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="research">
        <strong>How to read our survey</strong>
        <p>
          Respondents opted in. Graduates who are satisfied with their outcomes and still connected to their programs
          are probably over-represented, so treat the {outcomesSurvey.headline.employedWithinSixMonths} percent
          employment figure as a ceiling rather than a population estimate.
        </p>
        <p>
          Salary figures are self-reported first-position base pay and are not adjusted for region or cost of living. A
          $65,000 bachelor-level start in a high-cost metropolitan area is not the same outcome as the same number in a
          rural county. <a class="text-link" href="/research/">Read the full methodology and limitations →</a>
        </p>
      </div>
      <p><a class="text-link" href="/research/">See both studies in full →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Featured rankings</p>
          <h2>Start with the credential and the specialisation you actually need.</h2>
        </div>
        <p>Every ranking is generated from our program database and scored with the published Quality Index.</p>
      </div>
      <div class="grid">
        {featuredRankings.map(ranking => (
          <a class="card" href={`/rankings/${ranking.slug}/`}>
            <span class="label">Ranking</span>
            <h3>{ranking.title}</h3>
            <p>{ranking.intro}</p>
            <span class="text-link">See the ranking →</span>
          </a>
        ))}
      </div>
      <p style="margin-top:24px">
        <a class="text-link" href="/rankings/">Browse all {totalRankings} rankings →</a>
      </p>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Career research</p>
          <h2>Know what the job asks of you before you pick the degree.</h2>
        </div>
        <p>
          Each guide pairs the federal occupational data with an honest account of the daily work, including the parts
          that never appear in a recruitment brochure.
        </p>
      </div>
      <div class="grid">
        {careers.slice(0, 6).map(career => (
          <a class="card" href={`/careers/${career.slug}/`}>
            <span class="label">{career.track}</span>
            <h3>{career.title}</h3>
            <p>{career.summary}</p>
            <span class="text-link">Read the career guide →</span>
          </a>
        ))}
      </div>
      <p style="margin-top:24px"><a class="text-link" href="/careers/">All {careers.length} career guides →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Credentials and licensure</p>
          <h2>The RDN credential is the one that changes what you are allowed to do.</h2>
        </div>
        <p>
          Some credentials in this field carry practice authority. Others are continuing education marketed as though
          they carry practice authority. We are explicit about which is which.
        </p>
      </div>
      <div class="grid">
        {certifications.slice(0, 3).map(cert => (
          <a class="card" href={`/certifications/${cert.slug}/`}>
            <span class="label">{cert.short}</span>
            <h3>{cert.title}</h3>
            <p>{cert.takeaway}</p>
            <span class="text-link">Understand the credential →</span>
          </a>
        ))}
      </div>
      <p style="margin-top:24px">
        <a class="text-link" href="/certifications/">All {certifications.length} credentials compared →</a>
      </p>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Our methodology</p>
          <h2>Most nutrition rankings are a popularity contest with a spreadsheet attached.</h2>
        </div>
        <p>
          Ours is not, and you can check. The {qualityStudy.shortName} uses seven published factors, so any score can be
          reproduced from the record and disagreed with specifically.
        </p>
      </div>
      <div class="grid">
        <div class="card">
          <span class="label">What we measure</span>
          <h3>Documented program attributes</h3>
          <p>
            Curriculum rigor, supervised practice, faculty credentials, ACEND accreditation, clinical and community
            partnerships, completion, and published cost.
          </p>
        </div>
        <div class="card">
          <span class="label">What we refuse to measure</span>
          <h3>Reputation and self-reported placement</h3>
          <p>
            Asking deans to rate other deans measures name recognition. Asking programs for their own placement rate
            measures their marketing department.
          </p>
        </div>
        <a class="card" href="/methodology/">
          <span class="label">Transparency</span>
          <h3>Read the full method</h3>
          <p>
            Including the six things the index deliberately cannot capture, which is the section other ranking sites
            leave out.
          </p>
          <span class="text-link">Review the criteria →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Guides and analysis</p>
          <h2>The questions worth answering before you enroll.</h2>
        </div>
        <p>Long-form research from our team, with the numbers attached and the sources named.</p>
      </div>
      <div class="grid">
        {resources.slice(0, 6).map(resource => (
          <a class="card" href={`/resources/${resource.slug}/`}>
            <span class="label">{resource.kicker}</span>
            <h3>{resource.title}</h3>
            <p>{resource.summary}</p>
            <span class="text-link">Read the guide →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <p class="eyebrow">Programs by state</p>
      <h2>Find nutrition and dietetics programs near you.</h2>
      <p class="lede">
        Each state page lists the institutions in our database with links to their official program pages, the state
        public health agency that administers community nutrition programs, and the accredited supervised practice
        providers we can identify in that state.
      </p>
      <div class="state-grid" style="margin-top:28px">
        {stateList.map(([slug, name]) => <a href={`/states/${slug}/`}>{name} →</a>)}
      </div>
    </div>
  </section>

  <article class="content wrap">
    <h2>What do nutrition graduates actually earn?</h2>
    <p>
      The Bureau of Labor Statistics reported a May 2024 median annual wage of ${rdn.median.toLocaleString()} for
      dietitians and nutritionists, against ${bls.allOccupationsMedian.toLocaleString()} across all occupations. That
      headline number hides most of what matters. The lowest 10 percent earned under ${rdn.p10!.toLocaleString()} and
      the highest 10 percent earned above ${rdn.p90!.toLocaleString()}, a spread of more than $50,000 inside a single
      occupational code.
    </p>
    <p>
      Anyone quoting you one nutrition salary is compressing that spread into a figure that describes almost nobody.
      The useful question is not what dietitians earn. It is what dietitians earn in the setting you intend to work in,
      at the stage of career you will actually be at when you start.
    </p>
    <p>
      Our own {outcomesSurvey.name} gives the entry-level picture that federal data does not: a median first-position
      salary of $65,000 for bachelor-level respondents and $75,000 for master-level respondents. Those are our numbers
      from a self-selected sample, not a federal statistic, and we label them that way everywhere they appear.
    </p>

    <h2>Which nutrition settings pay the most?</h2>
    <p>
      Outpatient care centers, at a ${rdn.industries[0][1].toLocaleString()} median. Hospitals follow at
      {' '}${rdn.industries[1][1].toLocaleString()}, then government at ${rdn.industries[2][1].toLocaleString()}, then
      nursing and residential care facilities at ${rdn.industries[3][1].toLocaleString()}.
    </p>
    <p>
      That spread is narrower than in many health professions, which tells you something useful: in nutrition, setting
      choice matters less for pay than the credential does. The bigger financial variable is whether you hold the RDN,
      not whether you work inpatient or outpatient. This is the opposite of the pattern in fields like geoscience or
      engineering, and it should change how you allocate your effort as a student.
    </p>

    <h2>Why is the RDN credential the whole game?</h2>
    <p>
      Because it is the gate. Medical nutrition therapy is a defined scope of practice, and in most states providing it
      requires the credential plus state licensure or certification. Without it you are not competing for the same
      jobs, you are competing in a different and less regulated market where titles mean less and wages reflect that.
    </p>
    <p>
      Our survey found that {outcomesSurvey.headline.employerHiringDifficulty} percent of employers reported difficulty
      finding qualified RDN candidates. Read that alongside the {outcomesSurvey.headline.employedWithinSixMonths}
      {' '}percent employment figure. This is a field with a credential shortage, which means the credential is worth
      more than the school. That is genuinely good news, and it is the single most actionable thing on this page.
    </p>
    <p>
      Since January 2024 the Commission on Dietetic Registration has required a minimum of a graduate degree for
      examination eligibility. You will be paying for a masters whether or not you wanted one. Given that, the rational
      move is to choose a graduate program that also delivers your supervised practice, rather than paying separately
      for two gates. Our <a class="text-link" href="/rankings/best-nutrition-masters-programs/">masters ranking</a>
      {' '}exists mostly to help you do that.
    </p>

    <h2>How much does supervised practice matter?</h2>
    <p>
      More than anything else we measured. In our survey,
      {' '}{outcomesSurvey.headline.supervisedPracticeCritical} percent of {outcomesSurvey.sample.toLocaleString()}
      {' '}respondents described supervised practice or internship as critical or very important to their career. That
      was the strongest consensus in the entire study, stronger than any opinion about coursework, institution, or
      cost.
    </p>
    <p>
      It is also the component students investigate last. People compare tuition, campus, and ranking position, then
      discover in their final year that the program does not arrange placements and they are competing for local slots
      with no institutional relationship behind them. This is avoidable. Ask who arranges supervised practice, at which
      named sites, and what happens if a placement falls through. Get the answer in writing before you pay a deposit.
    </p>
    <p>
      It is why supervised practice carries 17 of the 100 points in our index, second only to curriculum rigor, and
      why we publish a
      {' '}<a class="text-link" href="/rankings/nutrition-programs-with-internship/">ranking of programs that document it</a>.
    </p>

    <h2>What skills do nutrition employers actually ask for?</h2>
    <p>
      Our survey asked respondents which skills employers requested most. Medical nutrition therapy led at
      {' '}{outcomesSurvey.skillsInDemand[0][1]} percent, followed by nutrition assessment at
      {' '}{outcomesSurvey.skillsInDemand[1][1]} percent and counseling and communication at
      {' '}{outcomesSurvey.skillsInDemand[2][1]} percent. Food service management came fourth at
      {' '}{outcomesSurvey.skillsInDemand[3][1]} percent, ahead of public health nutrition and research skills.
    </p>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Skill</th><th>Share of respondents reporting employer demand</th></tr></thead>
        <tbody>
          {outcomesSurvey.skillsInDemand.map(([skill, share]) => (
            <tr><td>{skill}</td><td>{share}%</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>
      Two things stand out. Communication ranks third, above every technical specialisation except assessment, which
      means the counseling coursework students treat as the soft option is closer to the core of the job than the
      electives they are excited about. And food service management outranks public health nutrition, which is not what
      most nutrition students expect and not what most programs emphasise.
    </p>

    <h2>How do we rank nutrition programs?</h2>
    <p>
      With the {qualityStudy.name}, a seven-factor score distributing 100 points across curriculum rigor (18),
      supervised practice and internship (17), faculty credentials (15), program accreditation (15), clinical and
      community partnerships (15), career outcomes (10), and cost value (10). Every factor is derived from something an
      institution or the accreditor publishes, which means any score we show can be reconstructed from the record.
    </p>
    <p>
      We do not use reputation surveys and we do not accept payment for placement. We also publish what the index
      cannot measure, including teaching quality, examination pass rates, and self-reported job placement, because a
      ranking that hides its blind spots is asking you to trust it rather than check it. The
      {' '}<a class="text-link" href="/methodology/">full methodology</a> is public, including the exclusions.
    </p>

    <h2>What should you do next?</h2>
    <ul>
      <li>Decide first whether you are pursuing the RDN credential. Everything else follows from that one answer.</li>
      <li>If you are, verify ACEND accreditation for the specific program, not the institution, and check whether the status is full accreditation or candidacy.</li>
      <li>Ask who arranges supervised practice, at which named sites, and get it in writing.</li>
      <li>Get a net cost figure from the financial aid office and weight it above any ranking position.</li>
      <li>Read the <a class="text-link" href="/resources/how-to-become-a-registered-dietitian-step-by-step/">step by step credential guide</a> before you apply anywhere.</li>
      <li>Check your state board rules on licensure and title use, because they vary more than students expect.</li>
    </ul>

    <Faq items={faq} />

    <div class="notice">
      <strong>Verify before you decide:</strong> program details, accreditation status, tuition, and credentialing
      requirements change. Every program listing on this site links to the institution's own page, which is the
      authoritative source, and every credentialing claim should be confirmed with the issuing body. Our database
      covers {stats.programs} programs at {stats.schools} institutions and is not exhaustive. Nothing on this site is
      medical or dietary advice.
    </div>
  </article>
</BaseLayout>

<style>
  .hero-actions { display: flex; align-items: center; gap: 24px; flex-wrap: wrap }
</style>
